# ===========================================================================
# A2UI v0.9 ADK Incident Operations Agent - Environment Configuration
# ===========================================================================

# Google Cloud Project ID (Required for Vertex AI)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI Location (Defaults to "global")
GOOGLE_CLOUD_LOCATION=global

# Force the google-genai SDK to use Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true

# Primary Gemini Model for ADK Agent (Defaults to gemini-3.8-flash)
MODEL=gemini-3.8-flash

# Image Generation Model for Incident Sketches (Defaults to gemini-3.1-flash-image)
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_LOCATION=global

# Service Port (Defaults to 8080)
PORT=8080

# Agent Public URL (Automatically set on Cloud Run, or http://127.0.0.1:8080 locally)
AGENT_URL=http://127.0.0.1:8080

# Optional in-app ID token check, only for hosting outside Cloud Run (VM, tunnel).
# On Cloud Run, deploy.sh keeps the service private and Cloud Run IAM checks callers.
# ENFORCE_IAM_AUTH=true
# ALLOWED_SERVICE_ACCOUNTS=service-<PROJECT_NUMBER>@gcp-sa-discoveryengine.iam.gserviceaccount.com
